# Copy to .env for local development. Every variable is required; there are no silent defaults.
AURA_ENV=local
AURA_ROLE=http
AURA_HTTP_HOST=127.0.0.1
AURA_HTTP_PORT=3001
AURA_DATABASE_URL=postgres://aura@127.0.0.1:54329/postgres
AURA_LOG_LEVEL=debug
AURA_TRUST_EDGE_REQUEST_ID=false
# Used only by database tests; they create and drop throwaway databases on this server.
AURA_TEST_DATABASE_URL=postgres://aura@127.0.0.1:54329/postgres
# The one origin browsers use to reach the site, checked against the Origin header on every
# state-changing request. Must be https in staging and prod.
AURA_PUBLIC_ORIGIN=http://localhost:3000
# Sign-in email. "mailpit" sends to the local mail catcher (see infra/compose.yml); "disabled" sends
# nothing. The catcher is refused outside local and test.
AURA_MAIL_DRIVER=mailpit
AURA_MAIL_API_URL=http://127.0.0.1:8025
AURA_MAIL_FROM=no-reply@auraland.test
# Key for hashing login codes and links. Generate your own: openssl rand -base64 32
AURA_LOGIN_TOKEN_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
# Used only by the mail tests, which fail without a running Mailpit.
AURA_TEST_MAILPIT_URL=http://127.0.0.1:8025
# Sign-in with GitHub / Google (optional; set both values of a provider to turn it on). Create the
# OAuth apps yourself; the callback URL is <AURA_PUBLIC_ORIGIN>/api/v1/auth/oauth/<provider>/callback.
# AURA_OAUTH_GITHUB_CLIENT_ID=
# AURA_OAUTH_GITHUB_CLIENT_SECRET=
# AURA_OAUTH_GOOGLE_CLIENT_ID=
# AURA_OAUTH_GOOGLE_CLIENT_SECRET=
# Used only by the object storage tests, which fail without the local S3 server in infra/compose.yml.
AURA_TEST_S3_ENDPOINT=http://127.0.0.1:8333
AURA_TEST_S3_ACCESS_KEY=aura-dev-access-key
AURA_TEST_S3_SECRET_KEY=aura-dev-secret-key-local-only
